class RscText {
    idc = -1;
    type = 0;
    style = 0;
    font = "RobotoCondensed";
    sizeEx = "(((((safezoneW / safezoneH) min 1.2) / 1.2) / 25) * 1)";
    colorBackground[] = {0,0,0,0};
    colorText[] = {1,1,1,1};
    shadow = 1;
};

class RscPicture {
    idc = -1;
    type = 0;
    style = 48;
    font = "TahomaB";
    sizeEx = 0;
    colorBackground[] = {0,0,0,0};
    colorText[] = {1,1,1,1};
};

class RscListBox {
    idc = -1;
    type = 5;
    style = 16;
    font = "RobotoCondensed";
    sizeEx = "(((((safezoneW / safezoneH) min 1.2) / 1.2) / 25) * 1)";
    colorText[] = {1,1,1,1};
    colorDisabled[] = {1,1,1,0.25};
    colorSelect[] = {0,0,0,1};
    colorSelect2[] = {0,0,0,1};
    colorSelectBackground[] = {0.95,0.95,0.95,1};
    colorSelectBackground2[] = {1,1,1,0.5};
    colorBackground[] = {0,0,0,0.3};
    maxHistoryDelay = 1;
    rowHeight = 0.04;
    soundSelect[] = {"",0.1,1};
    shadow = 0;
    colorShadow[] = {0,0,0,0.5};
    tooltipColorText[] = {1,1,1,1};
    tooltipColorBox[] = {1,1,1,1};
    tooltipColorShade[] = {0,0,0,0.65};
    class ListScrollBar {
        color[] = {1,1,1,1};
        autoScrollEnabled = 1;
    };
};

class RscButton {
    idc = -1;
    type = 1;
    style = 2;
    font = "RobotoCondensed";
    sizeEx = "(((((safezoneW / safezoneH) min 1.2) / 1.2) / 25) * 1)";
    colorBackground[] = {0,0,0,0.5};
    colorText[] = {1,1,1,1};
    colorDisabled[] = {1,1,1,0.25};
    colorBackgroundDisabled[] = {0,0,0,0.5};
    colorBackgroundActive[] = {0.1,0.1,0.1,1};
    colorFocused[] = {0.1,0.1,0.1,1};
    colorShadow[] = {0,0,0,0};
    colorBorder[] = {0,0,0,1};
    borderSize = 0;
    offsetX = 0;
    offsetY = 0;
    offsetPressedX = 0;
    offsetPressedY = 0;
    soundEnter[] = {"",0.1,1};
    soundPush[] = {"",0.1,1};
    soundClick[] = {"",0.1,1};
    soundEscape[] = {"",0.1,1};
};

class CameraMenuDialog {
    idd = 5000;
    movingEnable = false;
    enableSimulation = true;

    class controlsBackground {
        class CamMenuBackground: RscText {
            idc = 5099;
            text = "";
            x = 0.35 * safezoneW + safezoneX;
            y = 0.30 * safezoneH + safezoneY;
            w = 0.30 * safezoneW;
            h = 0.40 * safezoneH;
            colorBackground[] = {0,0,0,0.7};
        };
        class CamMenuTitle: RscText {
            idc = 5098;
            text = "Выбор камеры";
            x = 0.35 * safezoneW + safezoneX;
            y = 0.30 * safezoneH + safezoneY;
            w = 0.30 * safezoneW;
            h = 0.04 * safezoneH;
            style = 2;
            colorBackground[] = {0,0,0,0.9};
        };
    };

    class controls {
        class CamList: RscListBox {
            idc = 5100;
            x = 0.355 * safezoneW + safezoneX;
            y = 0.35 * safezoneH + safezoneY;
            w = 0.29 * safezoneW;
            h = 0.26 * safezoneH;
        };
        class ViewButton: RscButton {
            idc = 5101;
            text = "Просмотр";
            x = 0.355 * safezoneW + safezoneX;
            y = 0.63 * safezoneH + safezoneY;
            w = 0.14 * safezoneW;
            h = 0.04 * safezoneH;
            action = "call openCamView";
        };
        class CloseButton: RscButton {
            idc = 5102;
            text = "Закрыть";
            x = 0.505 * safezoneW + safezoneX;
            y = 0.63 * safezoneH + safezoneY;
            w = 0.14 * safezoneW;
            h = 0.04 * safezoneH;
            action = "call closeCamMenu";
        };
    };
};

