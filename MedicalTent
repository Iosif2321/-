if (!isServer) exitWith {};

// === Функция: развернуть палатку ===
fnc_deployMedTent = {
    params ["_target", "_caller", "_id"];

    if (speed _target > 1) exitWith {
        ["Техника должна быть полностью остановлена!"] remoteExec ["hint", _caller];
    };

    private _tentClass = "Land_MedicalTent_01_white_generic_open_F";

    // Позиция за машиной с учётом рельефа
    private _dir = getDir _target;
    private _vehicleSize = (boundingBoxReal _target select 1) select 1;
    private _distance = _vehicleSize + 7;

    private _tentPosFlat = _target modelToWorldWorld [0, -_distance, 0];
    private _groundZ = getTerrainHeightASL _tentPosFlat;
    private _tentPosASL = [_tentPosFlat select 0, _tentPosFlat select 1, _groundZ];
    private _tentPosATL = ASLToATL _tentPosASL;
    private _tentDir = _dir + 180;

    // Получаем размеры палатки
    private _tempTent = createVehicle [_tentClass, [0,0,0], [], 0, "NONE"];
    private _tentBounds = boundingBoxReal _tempTent;
    deleteVehicle _tempTent;

    private _min = _tentBounds select 0;
    private _max = _tentBounds select 1;
    private _tentRadiusX = abs ((_max select 0) - (_min select 0)) / 2;
    private _tentRadiusY = abs ((_max select 1) - (_min select 1)) / 2;
    private _tentRadius = sqrt (_tentRadiusX^2 + _tentRadiusY^2);

    // Проверка на препятствия
    private _nearObjects = nearestObjects [_tentPosATL, ["AllVehicles", "Man", "Thing", "Static", "Building"], _tentRadius + 1];
    private _nearTerrain = nearestTerrainObjects [_tentPosATL, ["TREE", "BUSH", "ROCK", "HOUSE", "WALL", "FENCE"], _tentRadius + 1];
    _nearObjects = _nearObjects select { _x != _target && alive _x };

    if (!(_nearObjects isEqualTo []) || !(_nearTerrain isEqualTo [])) exitWith {
        ["Зона для установки палатки занята объектами или препятствиями!"] remoteExec ["hint", _caller];
    };

    // === Спавн палатки ===
    private _tent = createVehicle [_tentClass, _tentPosATL, [], 0, "NONE"];
    _tent setDir _tentDir;

    // === Высадка экипажа ===
    {
        moveOut _x;
        ["Вы были высажены из техники для установки палатки."] remoteExec ["hint", _x];
    } forEach crew _target;

    // === Блокировка машины ===
    _target setFuel 0;
    _target lock 2;

    // === Переменные ===
    _target setVariable ["deployedTent", _tent, true];
    _target setVariable ["wasFuel", 1, true];

    // === Действие "Убрать палатку" ===
    [_tent, ["Убрать палатку", {
        params ["_tent", "_caller"];
        private _vehicle = nearestObject [_tent, "LandVehicle"];
        if (isServer) then {
            deleteVehicle _tent;
            _vehicle setVariable ["deployedTent", nil, true];
            _vehicle setFuel (_vehicle getVariable ["wasFuel", 1]);
            _vehicle lock 0;
        };
        ["Палатка убрана, машина снова доступна."] remoteExec ["hint", _caller];
    }, nil, 1.5, true, true, "", "true", 5]] remoteExec ["addAction", 0, true];

    ["Медицинская палатка развернута. Машина временно заблокирована."] remoteExec ["hint", _caller];
};

// === Добавляем действия на уже существующие HEMTT ===
{
    if (_x isKindOf "B_Truck_01_medical_F") then {
        [_x, ["Развернуть мед.палатку", {
            params ["_target", "_caller", "_id"];
            [_target, _caller, _id] remoteExecCall ["fnc_deployMedTent", 2];
        }, nil, 1.5, true, true, "", "isNull (_target getVariable ['deployedTent', objNull])", 5]] remoteExec ["addAction", 0, true];
    };
} forEach vehicles;

// === Обработчик появления новых HEMTT ===
addMissionEventHandler ["EntityCreated", {
    params ["_entity"];
    if (_entity isKindOf "B_Truck_01_medical_F") then {
        [_entity, ["Развернуть мед.палатку", {
            params ["_target", "_caller", "_id"];
            [_target, _caller, _id] remoteExecCall ["fnc_deployMedTent", 2];
        }, nil, 1.5, true, true, "", "isNull (_target getVariable ['deployedTent', objNull])", 5]] remoteExec ["addAction", 0, true];
    };
}];
