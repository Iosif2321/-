// Диалог меню выбора камеры
class CameraMenuDialog
{
    idd = 5000;
    movingEnable = false;
    enableSimulation = true;
    onLoad = "";
    onUnload = "";
    
    class Controls
    {
        class Background: RscText
        {
            idc = -1;
            x = 0.3 * safezoneW + safezoneX;
            y = 0.25 * safezoneH + safezoneY;
            w = 0.4 * safezoneW;
            h = 0.5 * safezoneH;
            colorBackground[] = {0, 0, 0, 0.8};
        };
        
        class TitleText: RscText
        {
            idc = -1;
            text = "Камеры наблюдения";
            x = 0.3 * safezoneW + safezoneX;
            y = 0.25 * safezoneH + safezoneY;
            w = 0.4 * safezoneW;
            h = 0.05 * safezoneH;
            colorBackground[] = {0.1, 0.1, 0.1, 1};
            colorText[] = {1, 1, 1, 1};
            font = "PuristaBold";
            sizeEx = 0.05;
            style = 2;
        };
        
        class CameraList: RscListBox
        {
            idc = 5100;
            x = 0.325 * safezoneW + safezoneX;
            y = 0.32 * safezoneH + safezoneY;
            w = 0.35 * safezoneW;
            h = 0.35 * safezoneH;
            colorBackground[] = {0, 0, 0, 0.5};
            rowHeight = 0.05;
            sizeEx = 0.04;
        };
        
        class ConnectButton: RscButton
        {
            idc = 5101;
            text = "Подключиться";
            x = 0.325 * safezoneW + safezoneX;
            y = 0.68 * safezoneH + safezoneY;
            w = 0.15 * safezoneW;
            h = 0.05 * safezoneH;
            action = "call openCamView";
        };
        
        class CloseButton: RscButton
        {
            idc = 5102;
            text = "Закрыть";
            x = 0.525 * safezoneW + safezoneX;
            y = 0.68 * safezoneH + safezoneY;
            w = 0.15 * safezoneW;
            h = 0.05 * safezoneH;
            action = "call closeCamMenu";
        };
    };
};

